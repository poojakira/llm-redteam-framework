__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
# Pickle model artifacts — never commit serialized models
*.pkl
# SHA-256 checksums are only useful if the matching .pkl is also present;
# committing an orphaned .sha256 (without the .pkl) is misleading.
*.pkl.sha256
report.json
.venv/
.venv-test/
.venv-audit/
.coverage
.coverage.*
htmlcov/
benchmarks/results/

# Logs
*.log

# OS
.DS_Store
Thumbs.db

# Local secrets and credentials
.env
.env.*
!.env.example
!.env.sample
*.pem
*.p12
*.pfx
*.key
id_rsa
id_ed25519
credentials.json
service-account*.json


# Cloud and local credential stores
.aws/
.azure/
.config/gcloud/
.kube/config
.docker/config.json
.netrc
.npmrc
.pypirc
.envrc
.direnv/
.secrets/

