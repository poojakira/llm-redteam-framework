# Safe local environment template
#
# Copy to .env only for local use, replace placeholders with your own values,
# and never commit the populated file.

# API authentication for the local FastAPI service.
REDTEAM_API_KEY=replace-with-your-own-32-plus-character-random-value

# Recommended rollout mode. Use "block" only after calibration.
REDTEAM_ENFORCEMENT_MODE=shadow
